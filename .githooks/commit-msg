#!/usr/bin/env python3
# Local first gate: the author and committer must be the owner, and the message
# must carry no assistant/bot attribution. Attribution means a credit line or
# trailer (co-authored-by, "generated by <tool>", robot emoji) — not the bare
# letters of a tool's name in ordinary prose, so a message may describe the
# no-assistant-attribution policy itself. Remote CI (scripts/CheckCommits.py) is
# the second gate and uses the same rule.
import os, re, subprocess, sys

owner = os.environ.get('OWNER_EMAIL', '').strip()
if not owner:
    sys.exit('Set OWNER_EMAIL before committing.')
for role in ['AUTHOR', 'COMMITTER']:
    ident = subprocess.check_output(['git', 'var', 'GIT_' + role + '_IDENT']).decode()
    if '<' + owner + '>' not in ident:
        sys.exit('Unauthorized ' + role + ' identity.')

message = open(sys.argv[1]).read()
attribution = re.compile(
    r'^\s*co-authored-by:\s'
    r'|generated\s+(?:with|by)\b[^\n]*\b(?:ai|claude|copilot|chatgpt|gemini|codex|anthropic|openai|bard)\b'
    r'|\b(?:authored|written|created)\s+by\b[^\n]*\b(?:claude|copilot|chatgpt|gemini|codex|anthropic)\b'
    r'|\U0001F916',
    re.IGNORECASE | re.MULTILINE,
)
if attribution.search(message):
    sys.exit('Prohibited attribution; edit the message manually.')
