# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# ── Node / web ─────────────────────────────────────────────────────────────
# dist/ is NOT ignored: it holds the hand-written app shell that GitHub Pages
# publishes. There is no build step that regenerates it. build/ holds the tracked
# installer scripts (spec/iss/ps1), so it is not ignored either.
node_modules/

# ── Installer build artifacts (generated, never committed) ─────────────────
.build-venv/
/build-work/
/dist-app/
/dist-installer/

# ── Secrets / private data (PUBLIC repo — keep these out, always) ──────────
/private/
*.key
*.pem
secrets.*
.env

# ── Internal governance & traceability (not published) ─────────────────────
# GOVERNANCE.md is internal guidance; _directives/ holds the D-NNN director
# asks and R-NNN implementor responses. Never committed.
GOVERNANCE.md
/_directives/

# ── Assistant working notes (kept local, never published) ──────────────────
# CLAUDE.md and the .claude/ working directory identify the authoring tool and
# are the owner's local notes. They stay on disk but out of this public repo.
CLAUDE.md
/.claude/

# ── Coverage / logs ────────────────────────────────────────────────────────
.coverage
coverage.xml
htmlcov/
*.log

# ── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
